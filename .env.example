VITE_CONTACT_ENDPOINT=/api/contact

# Backend receiver settings. These are read only by `npm run contact:server`.
CONTACT_HOST=127.0.0.1
CONTACT_PORT=8787
CONTACT_ALLOWED_ORIGIN=http://127.0.0.1:5173
CONTACT_TO_EMAIL=delbandbehdadfar@yahoo.com

# Email notification support through Resend.
# Create a backend-only API key and never expose it in VITE_* variables.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional webhook notification. Works with services that accept JSON POSTs.
CONTACT_FORWARD_URL=
